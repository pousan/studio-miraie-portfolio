:root {
  --bg: #FAF7F2;
  --text: #1C1917;
  --accent: #A16207;
  --surface: #FDFCFA;
  --muted: #5C554E;
  --border: #D8D2C8;

  --font-serif: 'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif CJK JP', serif;
  --font-sans: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 16px;
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  line-height: 1.9;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  margin: 0;
  background-color: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.9;
  overflow-x: hidden;
  overflow-wrap: anywhere;
  word-break: normal;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

/* Focus styles */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.cta-band :focus-visible {
  outline: 2px solid var(--bg);
  outline-offset: 3px;
}

/* Skip link */
.skip-link {
  position: absolute;
  top: -100px;
  left: 16px;
  z-index: 1000;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 8px 16px;
  background-color: var(--text);
  color: var(--bg);
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: underline;
  border: 2px solid var(--bg);
}

.skip-link:focus {
  top: 12px;
}

/* Links */
a {
  color: var(--text);
  text-decoration: underline;
  text-underline-offset: 0.2em;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}

a:hover {
  color: var(--accent);
}

