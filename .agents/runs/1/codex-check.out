.site-logo {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding-block: 4px;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text);
  text-decoration: none;
}

.site-logo:hover {
  color: var(--accent);
  text-decoration: underline;
}

.nav-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  padding: 8px 16px;
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text);
  background-color: var(--surface);
  border: 1px solid var(--text);
  border-radius: 2px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}

.nav-toggle:hover {
  background-color: var(--text);
  color: var(--bg);
}

.js-enabled .nav-toggle {
  display: inline-flex;
}

.site-nav {
  width: 100%;
  border-top: 1px solid var(--border);
  padding-top: 12px;
}

.js-enabled .site-nav[hidden] {
  display: none;
}

.nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-list a {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 8px 12px;
  font-size: 1rem;
  font-weight: 500;
  color: var(--text);
  text-decoration: underline;
  border-radius: 2px;
}

.nav-list a:hover {
  background-color: var(--surface);
  color: var(--accent);
}

.nav-list a[aria-current="page"] {
  font-weight: 700;
  color: var(--accent);
}

.nav-list .nav-cta {
  background-color: var(--text);
  color: var(--bg);
  border: 1px solid var(--text);
  font-weight: 600;
  justify-content: center;
}

.nav-list .nav-cta:hover {
  background-color: var(--surface);
  color: var(--text);
}

@media (min-width: 1024px) {
  .js-enabled .nav-toggle,
  .nav-toggle {
    display: none;
  }

  .site-nav,
  .js-enabled .site-nav[hidden] {
    display: block;
    width: auto;
    border-top: none;
    padding-top: 0;
  }

  .nav-list {
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
