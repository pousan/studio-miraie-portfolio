}

.media-3x2 {
  border: 1px solid var(--border);
  overflow: hidden;
}

.media-3x2 img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
  object-position: center;
}

/* Lists & Editorial tables */
.editorial-list {
  list-style: none;
  margin: 24px 0;
  padding: 0;
  border-top: 1px solid var(--border);
}

.editorial-list li {
  padding-block: 16px;
  border-bottom: 1px solid var(--border);
  max-width: 38em;
}

.service-list {
  margin-top: 32px;
  border-top: 1px solid var(--border);
}

.service-item {
  padding-block: 24px;
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
}

@media (min-width: 768px) {
  .service-item {
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
  }
}

.service-item h3 {
  margin-bottom: 0;
  font-size: 1.25rem;
}

/* Pricing cards */
.price-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.price-card-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.price-card h3 {
  margin-bottom: 0;
}

.price-block {
  padding-block: 12px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.price-value {
  display: block;
  font-family: var(--font-sans);
  font-size: 2.5rem; /* 40px */
  font-weight: 700;
  line-height: 1.2;
  color: var(--text);
}

@media (min-width: 768px) {
  .price-value {
    font-size: 2.75rem; /* 44px */
  }
}

@media (min-width: 1280px) {
  .price-value {
    font-size: 3rem; /* 48px */
  }
}

.price-unit {
  display: block;
  margin-top: 4px;
  font-size: 0.875rem; /* 14px */
  line-height: 1.75;
  color: var(--muted);
  font-weight: 600;
}

.conditions-list {
  margin-top: 32px;
  padding: 20px;
  background-color: var(--surface);
  border: 1px solid var(--border);
}

@media (min-width: 375px) {
  .conditions-list {
    padding: 24px;
  }
}

.conditions-list ul {
  margin: 0;
  padding-left: 20px;
}

.conditions-list li {
  margin-bottom: 8px;
  max-width: 38em;
}

.conditions-list li:last-child {
  margin-bottom: 0;
}

/* Process ordered list */
.process-list {
  list-style: none;
  margin: 32px 0 0;
  padding: 0;
  border-top: 1px solid var(--border);
  counter-reset: step;
}

.process-item {
  padding-block: 24px;
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
}

@media (min-width: 768px) {
  .process-item {
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
  }
}

.process-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text);
  margin: 0;
}

.process-num {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--accent);
  margin-right: 8px;
}

/* Callout box */
.callout-box {
  background-color: var(--surface);
  border: 2px solid var(--text);
  padding: 20px;
  margin-block: 24px;
}

@media (min-width: 375px) {
  .callout-box {
    padding: 24px;
  }
}

/* Contact Form */
.contact-form {
  max-width: 640px;
  margin-top: 24px;
}

.form-field {
  margin-bottom: 24px;
}

.form-label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--text);
}

.form-example {
  display: block;
  font-size: 0.875rem; /* 14px */
  line-height: 1.75;
  color: var(--muted);
  margin-bottom: 8px;
}

.form-input,
.form-textarea {
  width: 100%;
  min-height: 48px;
  padding: 12px 16px;
  font-family: var(--font-sans);
  font-size: 1rem; /* 16px */
  line-height: 1.6;
  color: var(--text);
  background-color: var(--surface);
  border: 1px solid var(--muted);
  border-radius: 2px;
}

.form-textarea {
  min-height: 140px;
  resize: vertical;
}

.form-input:disabled,
.form-textarea:disabled {
  background-color: var(--bg);
  color: var(--muted);
  cursor: not-allowed;
}

.form-input[aria-invalid="true"],
.form-textarea[aria-invalid="true"] {
  border: 2px solid var(--text);
}

.field-error {
  margin-top: 8px;
  padding: 8px 12px;
  background-color: var(--surface);
  border-left: 3px solid var(--accent);
  color: var(--text);
  font-size: 0.875rem; /* 14px */
  font-weight: 600;
  line-height: 1.75;
}

.field-error[hidden] {
  display: none;
}

.form-status {
  margin-top: 24px;
  padding: 16px 20px;
  background-color: var(--surface);
  border: 2px solid var(--text);
  color: var(--text);
  font-weight: 600;
}

.form-status[hidden] {
  display: none;
}

/* Column / Journal Editorial Grid */
.journal-article {
  border-top: 2px solid var(--text);
  padding-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.journal-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

@media (min-width: 375px) {
  .journal-meta {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
  }
}

.journal-date {
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.date-year {
  display: block;
  font-family: var(--font-sans);
  font-size: 0.875rem; /* 14px */
  font-weight: 600;
  line-height: 1.5;
  color: var(--muted);
}

.date-md {
  display: block;
  font-family: var(--font-sans);
  font-size: 2.25rem; /* 36px */
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: var(--text);
}

@media (min-width: 768px) {
  .date-md {
    font-size: 2.75rem; /* 44px */
  }
}

.date-note {
  display: block;
  font-size: 0.875rem; /* 14px */
  line-height: 1.75;
  color: var(--muted);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Legal dl */
.legal-dl {
  margin: 32px 0;
  border-top: 1px solid var(--border);
}

.legal-row {
  padding-block: 20px;
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8px;
}

@media (min-width: 768px) {
  .legal-row {
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
  }
}

.legal-row dt {
  font-weight: 700;
  color: var(--text);
}

.legal-row dd {
  margin: 0;
  max-width: 38em;
}

/* Common Bottom CTA Band */
.cta-band {
  background-color: var(--text);
  color: var(--bg);
  padding-block: 48px;
}

@media (min-width: 768px) {
  .cta-band {
    padding-block: 64px;
  }
}

.cta-band-inner {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

@media (min-width: 768px) {
  .cta-band-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
}

.cta-band .en-display {
  color: var(--bg);
}

.cta-band h2 {
  color: var(--bg);
}

.cta-band p {
  color: var(--bg);
}

.cta-band .supplement {
  color: var(--bg);
  margin-top: 12px;
}

.cta-band-action {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
}

.btn-inverse {
  background-color: var(--bg);
  color: var(--text);
  border: 1px solid var(--bg);
}

.btn-inverse:hover {
  background-color: var(--text);
  color: var(--bg);
  border-color: var(--bg);
}

/* Footer */
.site-footer {
  background-color: var(--bg);
  border-top: 1px solid var(--border);
  padding-block: 32px;
}

.footer-inner {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

@media (min-width: 768px) {
  .footer-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.footer-links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-links a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: 0.875rem; /* 14px */
  color: var(--text);
  text-decoration: underline;
}

.footer-links a:hover {
  color: var(--accent);
}

.footer-links a[aria-current="page"] {
  font-weight: 700;
  color: var(--accent);
}

.copyright {
  font-size: 0.875rem; /* 14px */
  color: var(--muted);
  margin: 0;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
(function () {
  'use strict';

  document.documentElement.classList.add('js-enabled');

  // Navigation menu toggle
  var navToggle = document.getElementById('nav-toggle');
  var siteNav = document.getElementById('site-nav');
  var mqDesktop = window.matchMedia('(min-width: 1024px)');

  function closeMenu(returnFocus) {
    if (!navToggle || !siteNav) return;
    navToggle.setAttribute('aria-expanded', 'false');
    navToggle.textContent = 'メニュー';
    if (!mqDesktop.matches) {
      siteNav.hidden = true;
    } else {
      siteNav.hidden = false;
    }
    if (returnFocus) {
      navToggle.focus();
    }
  }

  function openMenu() {
    if (!navToggle || !siteNav) return;
    navToggle.setAttribute('aria-expanded', 'true');
    navToggle.textContent = '閉じる';
    siteNav.hidden = false;
  }

  if (navToggle && siteNav) {
    // Initialize collapsed on mobile
    if (!mqDesktop.matches) {
      siteNav.hidden = true;
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.textContent = 'メニュー';
    } else {
      siteNav.hidden = false;
      navToggle.setAttribute('aria-expanded', 'false');
      navToggle.textContent = 'メニュー';
    }

    navToggle.addEventListener('click', function () {
      var isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu(false);
      } else {
        openMenu();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
        closeMenu(true);
      }
    });

    var navLinks = siteNav.querySelectorAll('a');
    for (var i = 0; i < navLinks.length; i++) {
      navLinks[i].addEventListener('click', function () {
        if (!mqDesktop.matches) {
          closeMenu(false);
        }
      });
    }

    if (typeof mqDesktop.addEventListener === 'function') {
      mqDesktop.addEventListener('change', function (e) {
        if (e.matches) {
          siteNav.hidden = false;
          navToggle.setAttribute('aria-expanded', 'false');
          navToggle.textContent = 'メニュー';
        } else {
          siteNav.hidden = true;
          navToggle.setAttribute('aria-expanded', 'false');
          navToggle.textContent = 'メニュー';
        }
      });
    }
  }

  // Mock contact form handling
  var form = document.getElementById('contact-form');
  if (form) {
    var nameInput = document.getElementById('contact-name');
    var emailInput = document.getElementById('contact-email');
    var shopInput = document.getElementById('contact-shop');
    var messageInput = document.getElementById('contact-message');
    var submitBtn = document.getElementById('contact-submit');
    var statusBox = document.getElementById('contact-status');

    var nameError = document.getElementById('contact-name-error');
    var emailError = document.getElementById('contact-email-error');
    var messageError = document.getElementById('contact-message-error');

    // Prevent any form submission
    form.addEventListener('submit', function (e) {
      e.preventDefault();
    });

    function setFieldState(input, errorEl, hintId, errorMessage) {
      if (!input || !errorEl) return;
      if (errorMessage) {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', hintId + ' ' + errorEl.id);
        errorEl.textContent = errorMessage;
        errorEl.hidden = false;
      } else {
        input.setAttribute('aria-invalid', 'false');
        input.setAttribute('aria-describedby', hintId);
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    }

    function isValidEmail(value) {
      if (!value || value.length > 254) return false;
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
    }

    function validateForm() {
      var firstInvalid = null;

      var nameVal = nameInput ? nameInput.value.trim() : '';
      if (!nameVal) {
        setFieldState(nameInput, nameError, 'contact-name-hint', 'お名前を入力してください。');
        if (!firstInvalid) firstInvalid = nameInput;
      } else {
        setFieldState(nameInput, nameError, 'contact-name-hint', '');
      }

      var emailVal = emailInput ? emailInput.value.trim() : '';
      if (!isValidEmail(emailVal)) {
        setFieldState(emailInput, emailError, 'contact-email-hint', 'メールアドレスの形式を確認してください。');
        if (!firstInvalid) firstInvalid = emailInput;
      } else {
        setFieldState(emailInput, emailError, 'contact-email-hint', '');
      }

      var messageVal = messageInput ? messageInput.value.trim() : '';
      if (!messageVal) {
        setFieldState(messageInput, messageError, 'contact-message-hint', 'ご相談内容を入力してください。');
        if (!firstInvalid) firstInvalid = messageInput;
      } else {
        setFieldState(messageInput, messageError, 'contact-message-hint', '');
      }

      if (firstInvalid) {
        if (statusBox) {
          statusBox.textContent = '';
          statusBox.hidden = true;
        }
        firstInvalid.focus();
        return false;
      }

      if (statusBox) {
        statusBox.textContent = '入力内容を確認しました。これはデモのため、送信・保存は行っていません。返信はありません。';
        statusBox.hidden = false;
      }
      return true;
    }

    var inputs = [nameInput, emailInput, shopInput, messageInput];
    for (var j = 0; j < inputs.length; j++) {
      if (inputs[j]) {
        inputs[j].disabled = false;
        if (inputs[j].tagName === 'INPUT') {
          inputs[j].addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
              e.preventDefault();
              validateForm();
            }
          });
        }
      }
    }

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.addEventListener('click', function (e) {
        e.preventDefault();
        validateForm();
      });
    }
  }
})();

