  1071	      showStep('review');
  1072	    });
  1073	  }
  1074	
  1075	  if (btnRecalculate) {
  1076	    btnRecalculate.addEventListener('click', function () {
  1077	      // Ensure all active questions have an answer; if Q2 became active without answer, go to Q2
  1078	      var activeIds = getActiveQuestionIds(state.answers);
  1079	      for (var i = 0; i < activeIds.length; i++) {
  1080	        if (!state.answers[activeIds[i]]) {
  1081	          showStep('question', activeIds[i]);
