   222	  function getActiveQuestionIds(answers) {
   223	    var ans = answers || {};
   224	    var ids = ['Q1'];
   225	    if (ans.Q1 === 'site') {
   226	      ids.push('Q2');
   227	    }
   228	    ids.push('Q3', 'Q4', 'Q5', 'Q6', 'Q7');
   229	    return ids;
   230	  }
   231	
   232	  function getOptionLabel(qId, value) {
   233	    var q = QUESTION_MAP[qId];
   234	    if (!q) return '';
   235	    for (var i = 0; i < q.options.length; i++) {
   236	      if (q.options[i].value === value) {
   237	        return q.options[i].label;
   238	      }
   239	    }
   240	    return '';
   241	  }
   242	
   243	  /**
   244	   * Pure function evaluate(answers) as specified in research.md §4.
   245	   * Generates structured result without any overall score.
   246	   */
   247	  function evaluate(rawAnswers) {
   248	    var answers = {};
   249	    if (rawAnswers && typeof rawAnswers === 'object') {
   250	      var keys = ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6', 'Q7'];
   251	      for (var k = 0; k < keys.length; k++) {
   252	        var key = keys[k];
   253	        if (typeof rawAnswers[key] === 'string' && rawAnswers[key]) {
   254	          answers[key] = rawAnswers[key];
   255	        }
   256	      }
   257	    }
   258	
   259	    // Discard Q2 if Q1 is not 'site'
   260	    if (answers.Q1 !== 'site') {
   261	      delete answers.Q2;
   262	    }
   263	
   264	    var activeQuestionIds = getActiveQuestionIds(answers);
   265	
   266	    // 1. Good items ("回答上、整っていること")
   267	    var goodItems = [];
   268	    for (var i = 0; i < activeQuestionIds.length; i++) {
   269	      var qId = activeQuestionIds[i];
   270	      var val = answers[qId];
   271	      if (val && GOOD_RULES[qId] && GOOD_RULES[qId][val]) {
   272	        goodItems.push({
   273	          questionId: qId,
   274	          value: val,
   275	          text: GOOD_RULES[qId][val]
   276	        });
   277	      }
   278	    }
   279	
   280	    // 2. Review items ("まず見直すこと", sorted by PRIORITY_ORDER: Q3・Q4 -> Q2・Q6 -> Q5・Q7)
   281	    var reviewItems = [];
   282	    for (var p = 0; p < PRIORITY_ORDER.length; p++) {
   283	      var prioQId = PRIORITY_ORDER[p];
   284	      if (prioQId === 'Q2' && answers.Q1 !== 'site') {
   285	        continue;
   286	      }
   287	      var ansVal = answers[prioQId];
   288	      if (ansVal && REVIEW_RULES[prioQId] && REVIEW_RULES[prioQId][ansVal]) {
   289	        var rule = REVIEW_RULES[prioQId][ansVal];
   290	        reviewItems.push({
   291	          questionId: prioQId,
   292	          value: ansVal,
   293	          title: rule.title,
   294	          answerLabel: rule.answerLabel,
   295	          body: rule.body
   296	        });
   297	      }
   298	    }
   299	
   300	    var primaryReviewItems = reviewItems.slice(0, 3);
   301	    var remainingReviewItems = reviewItems.slice(3);
   302	
   303	    // 3. Unknown items ("まだ確認していないこと")
   304	    var unknownItems = [];
   305	    for (var u = 0; u < activeQuestionIds.length; u++) {
   306	      var uQId = activeQuestionIds[u];
   307	      var uVal = answers[uQId];
   308	      if (uVal === 'unknown' && UNKNOWN_RULES[uQId]) {
   309	        unknownItems.push({
   310	          questionId: uQId,
   311	          value: uVal,
   312	          title: UNKNOWN_RULES[uQId].title,
   313	          answerLabel: UNKNOWN_RULES[uQId].answerLabel,
   314	          procedure: UNKNOWN_RULES[uQId].procedure
   315	        });
   316	      }
   317	    }
   318	
   319	    // Website-less guidance when Q1 is social or none
   320	    var noWebsiteAdvice = '';
   321	    if (answers.Q1 === 'social') {
   322	      noWebsiteAdvice = 'ホームページをお持ちでない場合も、まずは現在お使いのInstagramや店舗紹介ページ、Googleマップに「営業時間・定休日・場所・主なメニュー・連絡方法」の基本案内を揃えることから始められます。ホームページ制作だけが唯一の解決策ではありません。複数の媒体の情報をひとつにまとめたくなった段階で制作をご検討ください。';
   323	    } else if (answers.Q1 === 'none') {
   324	      noWebsiteAdvice = 'ホームページやSNSをお持ちでない場合も、まずは無料で登録できるGoogleマップ（Googleビジネスプロフィール）やInstagramなどに「営業時間・定休日・住所・主なメニュー」の基本案内を揃えることから始められます。ホームページ制作だけが唯一の解決策ではありません。';
   325	    }
   326	
   327	    // Status message logic (all good vs unknown only vs has review items)
   328	    var statusType = 'has_issues';
   329	    var statusMessage = '';
   330	    if (reviewItems.length === 0 && unknownItems.length === 0) {
   331	      statusType = 'all_good';
   332	      statusMessage = '今回の回答では、優先して直す項目は見つかりませんでした。';
   333	    } else if (reviewItems.length === 0 && unknownItems.length > 0) {
   334	      statusType = 'unknown_only';
   335	      statusMessage = 'まず現状を確認しましょう。今回の回答では明確な不備は選ばれていませんが、まだ確認していない項目があります。下の確認手順に沿って現在の案内状況を確かめてみてください。';
   336	    }
   337	
   338	    // Answered items summary with renumbered display numbers
   339	    var answeredSummary = [];
   340	    for (var s = 0; s < activeQuestionIds.length; s++) {
   341	      var sQId = activeQuestionIds[s];
   342	      var sQ = QUESTION_MAP[sQId];
   343	      var sVal = answers[sQId] || '';
   344	      answeredSummary.push({
   345	        questionId: sQId,
   346	        displayNumber: s + 1,
   347	        questionText: sQ ? sQ.text : '',
   348	        value: sVal,
   349	        answerLabel: getOptionLabel(sQId, sVal)
   350	      });
   351	    }
   352	
   353	    return {
   354	      activeQuestionIds: activeQuestionIds,
   355	      totalQuestions: activeQuestionIds.length,
   356	      answers: answers,
   357	      goodItems: goodItems,
   358	      reviewItems: reviewItems,
   359	      primaryReviewItems: primaryReviewItems,
   360	      remainingReviewItems: remainingReviewItems,
   361	      unknownItems: unknownItems,
   362	      noWebsiteAdvice: noWebsiteAdvice,
   363	      statusType: statusType,
   364	      statusMessage: statusMessage,
   365	      answeredSummary: answeredSummary
   366	    };
   367	  }
   368	
   369	  // Expose pure function for testing/verification
   370	  window.evaluate = evaluate;
   371	  window.evaluateShindan = evaluate;
   372	
   373	  // State management
   374	  var state = {
   375	    version: STATE_VERSION,
   376	    step: 'intro',
   377	    currentQuestionId: 'Q1',
   378	    answers: {}
   379	  };
   380	
   381	  function saveStateToStorage() {
   382	    try {
   383	      var payload = JSON.stringify({
   384	        version: state.version,
   385	        step: state.step,
   386	        currentQuestionId: state.currentQuestionId,
   387	        answers: state.answers
   388	      });
   389	      window.sessionStorage.setItem(STORAGE_KEY, payload);
   390	    } catch (e) {
   391	      // Continue silently if sessionStorage is unavailable
   392	    }
   393	  }
   394	
   395	  function clearStorage() {
   396	    try {
   397	      window.sessionStorage.removeItem(STORAGE_KEY);
   398	    } catch (e) {
   399	      // Ignore
   400	    }
   401	  }
   402	
   403	  function loadStateFromStorage() {
   404	    try {
   405	      var raw = window.sessionStorage.getItem(STORAGE_KEY);
   406	      if (!raw) return null;
   407	      var parsed = JSON.parse(raw);
   408	      if (!parsed || parsed.version !== STATE_VERSION || typeof parsed.answers !== 'object') {
   409	        return null;
   410	      }
   411	      var cleanAnswers = {};
   412	      for (var i = 0; i < QUESTIONS.length; i++) {
   413	        var q = QUESTIONS[i];
   414	        var val = parsed.answers[q.id];
   415	        if (val && getOptionLabel(q.id, val)) {
   416	          cleanAnswers[q.id] = val;
   417	        }
   418	      }
   419	      if (cleanAnswers.Q1 !== 'site') {
   420	        delete cleanAnswers.Q2;
   421	      }
   422	      return {
   423	        version: STATE_VERSION,
   424	        step: parsed.step || 'intro',
   425	        currentQuestionId: parsed.currentQuestionId || 'Q1',
   426	        answers: cleanAnswers
   427	      };
   428	    } catch (e) {
   429	      return null;
   430	    }
   431	  }
   432	
   433	  // DOM References
   434	  var stepIntro = document.getElementById('step-intro');
   435	  var stepQuestion = document.getElementById('step-question');
   436	  var stepReview = document.getElementById('step-review');
   437	  var stepResult = document.getElementById('step-result');
   438	
   439	  if (!stepIntro || !stepQuestion || !stepResult) {
   440	    return;
   441	  }
   442	
   443	  var btnStart = document.getElementById('btn-start');
   444	  var btnPrev = document.getElementById('btn-prev');
   445	  var btnNext = document.getElementById('btn-next');
   446	  var questionError = document.getElementById('question-error');
   447	  var progressText = document.getElementById('progress-text');
   448	  var progressBar = document.getElementById('progress-bar');
   449	  var progressFill = document.getElementById('progress-fill');
   450	  var progressBranchNote = document.getElementById('progress-branch-note');
   451	
   452	  var btnCopyResult = document.getElementById('btn-copy-result');
   453	  var btnReviewAnswers = document.getElementById('btn-review-answers');
   454	  var btnRestart = document.getElementById('btn-restart');
   455	  var btnPrint = document.getElementById('btn-print');
   456	  var btnRecalculate = document.getElementById('btn-recalculate');
   457	  var btnCancelReview = document.getElementById('btn-cancel-review');
   458	
   459	  var copyStatus = document.getElementById('copy-status');
   460	  var copyFallbackBox = document.getElementById('copy-fallback-box');
   461	  var copyFallbackTextarea = document.getElementById('copy-fallback-textarea');
   462	
   463	  function syncRadiosFromAnswers() {
   464	    for (var i = 0; i < QUESTIONS.length; i++) {
   465	      var qId = QUESTIONS[i].id;
   466	      var selectedVal = state.answers[qId] || '';
   467	      var panel = document.getElementById('panel-' + qId);
   468	      if (!panel) continue;
   469	      var labels = panel.querySelectorAll('.shindan-option');
   470	      for (var j = 0; j < labels.length; j++) {
   471	        var label = labels[j];
   472	        var val = label.getAttribute('data-value');
   473	        var radio = label.querySelector('input[type="radio"]');
   474	        var isSelected = selectedVal === val;
   475	        if (radio) {
   476	          radio.checked = isSelected;
   477	        }
   478	        if (isSelected) {
   479	          label.classList.add('is-selected');
   480	        } else {
   481	          label.classList.remove('is-selected');
   482	        }
   483	      }
   484	    }
   485	  }
   486	
   487	  function setAnswer(qId, value) {
   488	    if (!QUESTION_MAP[qId] || !getOptionLabel(qId, value)) return;
   489	    state.answers[qId] = value;
   490	    // If Q1 is changed to anything other than 'site', discard Q2 immediately
   491	    if (qId === 'Q1' && value !== 'site') {
   492	      delete state.answers.Q2;
   493	    }
   494	    syncRadiosFromAnswers();
   495	    hideQuestionError();
   496	    updateProgressUI();
   497	    saveStateToStorage();
   498	  }
   499	
   500	  function showQuestionError() {
   501	    if (!questionError) return;
   502	    questionError.textContent = '選択肢を選んでください。わからない場合も選べます';
   503	    questionError.hidden = false;
   504	  }
   505	
   506	  function hideQuestionError() {
   507	    if (!questionError) return;
   508	    questionError.hidden = true;
   509	  }
   510	
   511	  function updateProgressUI() {
   512	    var activeIds = getActiveQuestionIds(state.answers);
   513	    var total = activeIds.length;
   514	    var idx = activeIds.indexOf(state.currentQuestionId);
   515	    if (idx === -1) idx = 0;
   516	    var currentNum = idx + 1;
   517	
   518	    // Update displayed question numbers across all active panels
   519	    for (var i = 0; i < activeIds.length; i++) {
   520	      var qId = activeIds[i];
   521	      var numSpan = document.querySelector('[data-q-num="' + qId + '"]');
   522	      if (numSpan) {
   523	        numSpan.textContent = '質問' + (i + 1);
   524	      }
   525	    }
   526	
   527	    if (progressText) {
   528	      progressText.textContent = '質問' + currentNum + ' / 全' + total + '問';
   529	    }
   530	    if (progressBar) {
   531	      progressBar.setAttribute('aria-valuemax', String(total));
   532	      progressBar.setAttribute('aria-valuenow', String(currentNum));
   533	    }
   534	    if (progressFill) {
   535	      var pct = Math.round((currentNum / total) * 10000) / 100;
   536	      progressFill.style.width = pct + '%';
   537	    }
   538	    if (progressBranchNote) {
   539	      var isSkipped = Boolean(state.answers.Q1 && state.answers.Q1 !== 'site');
   540	      progressBranchNote.hidden = !isSkipped;
   541	    }
   542	    if (btnNext) {
   543	      var isLast = idx === activeIds.length - 1;
   544	      btnNext.textContent = isLast ? '結果を見る' : '次へ';
   545	    }
   546	  }
   547	
   548	  function pushHistoryState(replace) {
   549	    if (!window.history || typeof window.history.pushState !== 'function') return;
   550	    var histData = {
   551	      shindan: true,
   552	      step: state.step,
   553	      currentQuestionId: state.currentQuestionId
   554	    };
   555	    try {
   556	      if (replace) {
   557	        window.history.replaceState(histData, '');
   558	      } else {
   559	        window.history.pushState(histData, '');
   560	      }
   561	    } catch (e) {
   562	      // Ignore history errors in restricted environments
   563	    }
   564	  }
   565	
   566	  function focusElement(el) {
   567	    if (!el) return;
   568	    try {
   569	      el.focus();
   570	    } catch (e) {
   571	      // Ignore
   572	    }
   573	  }
   574	
   575	  function showStep(stepName, questionId, options) {
   576	    var opts = options || {};
   577	    state.step = stepName;
   578	    if (questionId) {
   579	      state.currentQuestionId = questionId;
   580	    }
   581	
   582	    // Ensure Q2 is never shown if Q1 !== 'site'
   583	    if (state.step === 'question') {
   584	      var activeIds = getActiveQuestionIds(state.answers);
   585	      if (activeIds.indexOf(state.currentQuestionId) === -1) {
   586	        state.currentQuestionId = activeIds[0];
   587	      }
   588	    }
   589	
   590	    stepIntro.hidden = state.step !== 'intro';
   591	    stepQuestion.hidden = state.step !== 'question';
   592	    if (stepReview) {
   593	      stepReview.hidden = state.step !== 'review';
   594	    }
   595	    stepResult.hidden = state.step !== 'result';
   596	
   597	    hideQuestionError();
   598	    if (copyStatus) copyStatus.hidden = true;
   599	    if (copyFallbackBox) copyFallbackBox.hidden = true;
   600	
   601	    if (state.step === 'intro') {
   602	      syncRadiosFromAnswers();
   603	      if (!opts.skipFocus) {
   604	        focusElement(document.getElementById('intro-heading'));
   605	      }
   606	    } else if (state.step === 'question') {
   607	      syncRadiosFromAnswers();
   608	      for (var i = 0; i < QUESTIONS.length; i++) {
   609	        var qId = QUESTIONS[i].id;
   610	        var panel = document.getElementById('panel-' + qId);
   611	        if (panel) {
   612	          panel.hidden = qId !== state.currentQuestionId;
   613	        }
   614	      }
   615	      stepQuestion.setAttribute('data-current-question', state.currentQuestionId);
   616	      updateProgressUI();
   617	      if (!opts.skipFocus) {
   618	        focusElement(document.getElementById('legend-' + state.currentQuestionId));
   619	      }
   620	    } else if (state.step === 'review') {
   621	      renderReviewScreen();
   622	      if (!opts.skipFocus) {
   623	        focusElement(document.getElementById('review-heading'));
   624	      }
   625	    } else if (state.step === 'result') {
   626	      renderResultScreen();
   627	      if (!opts.skipFocus) {
   628	        focusElement(document.getElementById('result-heading'));
   629	      }
   630	    }
   631	
   632	    saveStateToStorage();
   633	    if (!opts.fromPopState) {
   634	      pushHistoryState(Boolean(opts.replaceHistory));
   635	    }
   636	  }
   637	
   638	  function createReviewCardElement(item) {
   639	    var card = document.createElement('article');
   640	    card.className = 'shindan-result-card';
   641	    card.setAttribute('data-result-q', item.questionId);
   642	
   643	    var h4 = document.createElement('h4');
   644	    h4.textContent = item.title;
   645	    card.appendChild(h4);
   646	
   647	    var ansBadge = document.createElement('p');
   648	    ansBadge.className = 'shindan-your-answer';
   649	    ansBadge.textContent = 'あなたの回答：「' + item.answerLabel + '」';
   650	    card.appendChild(ansBadge);
   651	
   652	    var bodyP = document.createElement('p');
   653	    bodyP.textContent = item.body;
   654	    card.appendChild(bodyP);
   655	
   656	    return card;
   657	  }
   658	
   659	  function createUnknownCardElement(item) {
   660	    var card = document.createElement('article');
   661	    card.className = 'shindan-result-card';
   662	    card.setAttribute('data-unknown-q', item.questionId);
   663	
   664	    var h4 = document.createElement('h4');
   665	    h4.textContent = item.title;
   666	    card.appendChild(h4);
   667	
   668	    var ansBadge = document.createElement('p');
   669	    ansBadge.className = 'shindan-your-answer';
   670	    ansBadge.textContent = 'あなたの回答：「' + item.answerLabel + '」';
   671	    card.appendChild(ansBadge);
   672	
   673	    var procP = document.createElement('p');
   674	    procP.textContent = item.procedure;
   675	    card.appendChild(procP);
   676	
   677	    return card;
   678	  }
   679	
   680	  function renderResultScreen() {
   681	    var result = evaluate(state.answers);
   682	
   683	    // Overall summary banner (all good or unknown only)
   684	    var summaryBanner = document.getElementById('result-summary-banner');
   685	    var summaryText = document.getElementById('result-summary-text');
   686	    if (summaryBanner && summaryText) {
   687	      if (result.statusMessage) {
   688	        summaryText.textContent = result.statusMessage;
   689	        summaryBanner.hidden = false;
   690	      } else {
   691	        summaryText.textContent = '';
   692	        summaryBanner.hidden = true;
   693	      }
   694	    }
   695	
   696	    // 1. Good items ("回答上、整っていること")
   697	    var goodList = document.getElementById('result-good-list');
   698	    var goodEmptyNote = document.getElementById('good-empty-note');
   699	    if (goodList) {
   700	      while (goodList.firstChild) {
   701	        goodList.removeChild(goodList.firstChild);
   702	      }
   703	      if (result.goodItems.length === 0) {
   704	        if (goodEmptyNote) goodEmptyNote.hidden = false;
   705	      } else {
   706	        if (goodEmptyNote) goodEmptyNote.hidden = true;
   707	        for (var g = 0; g < result.goodItems.length; g++) {
   708	          var li = document.createElement('li');
   709	          var badge = document.createElement('span');
   710	          badge.className = 'shindan-good-mark';
   711	          badge.textContent = '確認済';
   712	          var textSpan = document.createElement('span');
   713	          textSpan.textContent = result.goodItems[g].text;
   714	          li.appendChild(badge);
   715	          li.appendChild(textSpan);
   716	          goodList.appendChild(li);
   717	        }
   718	      }
   719	    }
   720	
   721	    // 2. Review items ("まず見直すこと")
   722	    var noSiteAdviceBox = document.getElementById('result-no-site-advice');
   723	    var noSiteAdviceText = document.getElementById('result-no-site-text');
   724	    if (noSiteAdviceBox && noSiteAdviceText) {
   725	      if (result.noWebsiteAdvice) {
   726	        noSiteAdviceText.textContent = result.noWebsiteAdvice;
   727	        noSiteAdviceBox.hidden = false;
   728	      } else {
   729	        noSiteAdviceText.textContent = '';
   730	        noSiteAdviceBox.hidden = true;
   731	      }
   732	    }
   733	
   734	    var reviewEmptyMsg = document.getElementById('review-empty-message');
   735	    var primaryContainer = document.getElementById('result-review-primary');
   736	    var remainingBlock = document.getElementById('result-review-remaining-block');
   737	    var remainingContainer = document.getElementById('result-review-remaining');
   738	
   739	    if (primaryContainer) {
   740	      while (primaryContainer.firstChild) {
   741	        primaryContainer.removeChild(primaryContainer.firstChild);
   742	      }
   743	    }
   744	    if (remainingContainer) {
   745	      while (remainingContainer.firstChild) {
   746	        remainingContainer.removeChild(remainingContainer.firstChild);
   747	      }
   748	    }
   749	
   750	    if (result.reviewItems.length === 0) {
   751	      if (reviewEmptyMsg) {
   752	        reviewEmptyMsg.textContent =
   753	          result.statusType === 'unknown_only'
   754	            ? 'まず現状を確認しましょう。今回の回答では明確な不備は選ばれていません。下の「まだ確認していないこと」の手順に沿って、現在の案内状況を確かめてみてください。'
   755	            : '今回の回答では、優先して直す項目は見つかりませんでした。';
   756	        reviewEmptyMsg.hidden = false;
   757	      }
   758	      if (remainingBlock) {
   759	        remainingBlock.hidden = true;
   760	      }
   761	    } else {
   762	      if (reviewEmptyMsg) {
   763	        reviewEmptyMsg.textContent = '';
   764	        reviewEmptyMsg.hidden = true;
   765	      }
   766	      for (var r = 0; r < result.primaryReviewItems.length; r++) {
   767	        primaryContainer.appendChild(createReviewCardElement(result.primaryReviewItems[r]));
   768	      }
   769	      if (result.remainingReviewItems.length > 0 && remainingBlock && remainingContainer) {
   770	        for (var rem = 0; rem < result.remainingReviewItems.length; rem++) {
   771	          remainingContainer.appendChild(createReviewCardElement(result.remainingReviewItems[rem]));
   772	        }
   773	        remainingBlock.hidden = false;
   774	      } else if (remainingBlock) {
   775	        remainingBlock.hidden = true;
   776	      }
   777	    }
   778	
   779	    // 3. Unknown items ("まだ確認していないこと")
   780	    var unknownList = document.getElementById('result-unknown-list');
   781	    var unknownEmptyNote = document.getElementById('unknown-empty-note');
   782	    if (unknownList) {
   783	      while (unknownList.firstChild) {
   784	        unknownList.removeChild(unknownList.firstChild);
   785	      }
   786	      if (result.unknownItems.length === 0) {
   787	        if (unknownEmptyNote) unknownEmptyNote.hidden = false;
   788	      } else {
   789	        if (unknownEmptyNote) unknownEmptyNote.hidden = true;
   790	        for (var u = 0; u < result.unknownItems.length; u++) {
   791	          unknownList.appendChild(createUnknownCardElement(result.unknownItems[u]));
   792	        }
   793	      }
   794	    }
   795	
   796	    // 4. Answered questions summary & individual edit links
   797	    var summaryContainer = document.getElementById('result-answers-summary');
   798	    if (summaryContainer) {
   799	      while (summaryContainer.firstChild) {
   800	        summaryContainer.removeChild(summaryContainer.firstChild);
   801	      }
   802	      for (var s = 0; s < result.answeredSummary.length; s++) {
   803	        var rowData = result.answeredSummary[s];
   804	        var row = document.createElement('div');
   805	        row.className = 'shindan-answer-row';
   806	
   807	        var mainDiv = document.createElement('div');
   808	        mainDiv.className = 'shindan-answer-row-main';
   809	
   810	        var qP = document.createElement('p');
   811	        qP.className = 'shindan-answer-q';
   812	        qP.textContent = '質問' + rowData.displayNumber + '：' + rowData.questionText;
   813	
   814	        var aP = document.createElement('p');
   815	        aP.className = 'shindan-answer-val';
   816	        aP.textContent = '回答：' + (rowData.answerLabel || '未回答');
   817	
   818	        mainDiv.appendChild(qP);
   819	        mainDiv.appendChild(aP);
   820	
   821	        var editBtn = document.createElement('button');
   822	        editBtn.type = 'button';
   823	        editBtn.className = 'btn btn-secondary shindan-no-print';
   824	        editBtn.setAttribute('data-edit-q', rowData.questionId);
   825	        editBtn.textContent = '質問' + rowData.displayNumber + 'を修正する';
   826	        editBtn.addEventListener(
   827	          'click',
   828	          (function (targetQId) {
   829	            return function () {
   830	              showStep('question', targetQId);
   831	            };
   832	          })(rowData.questionId)
   833	        );
   834	
   835	        row.appendChild(mainDiv);
   836	        row.appendChild(editBtn);
   837	        summaryContainer.appendChild(row);
   838	      }
   839	    }
   840	  }
   841	
   842	  function renderReviewScreen() {
   843	    var container = document.getElementById('review-questions-container');
   844	    if (!container) return;
   845	    while (container.firstChild) {
   846	      container.removeChild(container.firstChild);
   847	    }
   848	
   849	    var activeIds = getActiveQuestionIds(state.answers);
   850	    for (var i = 0; i < activeIds.length; i++) {
   851	      var qId = activeIds[i];
   852	      var q = QUESTION_MAP[qId];
   853	      if (!q) continue;
   854	
   855	      var itemDiv = document.createElement('div');
   856	      itemDiv.className = 'shindan-review-item';
   857	
   858	      var fieldset = document.createElement('fieldset');
   859	      fieldset.className = 'shindan-fieldset';
   860	
   861	      var legend = document.createElement('legend');
   862	      legend.className = 'shindan-legend';
   863	
   864	      var numSpan = document.createElement('span');
   865	      numSpan.className = 'shindan-q-num';
   866	      numSpan.textContent = '質問' + (i + 1);
   867	      legend.appendChild(numSpan);
   868	      legend.appendChild(document.createTextNode(q.text));
   869	      fieldset.appendChild(legend);
   870	
   871	      if (q.supplement) {
   872	        var supp = document.createElement('p');
   873	        supp.className = 'shindan-supplement';
   874	        supp.textContent = q.supplement;
   875	        fieldset.appendChild(supp);
   876	      }
   877	
   878	      var optionsWrap = document.createElement('div');
   879	      optionsWrap.className = 'shindan-options';
   880	
   881	      for (var j = 0; j < q.options.length; j++) {
   882	        var opt = q.options[j];
   883	        var isChecked = state.answers[qId] === opt.value;
   884	
   885	        var label = document.createElement('label');
   886	        label.className = 'shindan-option' + (isChecked ? ' is-selected' : '');
   887	        label.setAttribute('data-review-q', qId);
   888	        label.setAttribute('data-review-value', opt.value);
   889	
   890	        var mainSpan = document.createElement('span');
   891	        mainSpan.className = 'shindan-option-main';
   892	
   893	        var radio = document.createElement('input');
   894	        radio.type = 'radio';
   895	        radio.className = 'shindan-radio';
   896	        radio.name = 'review-' + qId;
   897	        radio.value = opt.value;
   898	        radio.checked = isChecked;
   899	
   900	        radio.addEventListener(
   901	          'change',
   902	          (function (questionId, optionValue) {
   903	            return function () {
   904	              setAnswer(questionId, optionValue);
   905	              // If Q1 changed, Q2 visibility and question numbers change; if Q2 was newly revealed, set default or let user choose
   906	              if (questionId === 'Q1' && optionValue === 'site' && !state.answers.Q2) {
   907	                state.answers.Q2 = 'unknown';
   908	              }
   909	              renderReviewScreen();
   910	            };
   911	          })(qId, opt.value)
   912	        );
   913	
   914	        var textSpan = document.createElement('span');
   915	        textSpan.className = 'shindan-option-text';
   916	        textSpan.textContent = opt.label;
   917	
   918	        var badgeSpan = document.createElement('span');
   919	        badgeSpan.className = 'shindan-option-badge';
   920	        badgeSpan.setAttribute('aria-hidden', 'true');
   921	        badgeSpan.textContent = '選択中';
   922	
   923	        mainSpan.appendChild(radio);
   924	        mainSpan.appendChild(textSpan);
   925	        label.appendChild(mainSpan);
   926	        label.appendChild(badgeSpan);
   927	        optionsWrap.appendChild(label);
   928	      }
   929	
   930	      fieldset.appendChild(optionsWrap);
   931	      itemDiv.appendChild(fieldset);
   932	      container.appendChild(itemDiv);
   933	    }
   934	  }
   935	
   936	  function buildCopyText() {
   937	    var result = evaluate(state.answers);
   938	    var lines = [];
   939	    lines.push('【Studio Miraie 無料セルフチェック結果】');
   940	    lines.push('※これは回答に基づくセルフチェックです。サイトの実測・検索順位の確認・専門家による個別調査は行っていません。');
   941	    lines.push('');
   942	
   943	    if (result.statusMessage) {
   944	      lines.push(result.statusMessage);
   945	      lines.push('');
   946	    }
   947	
   948	    lines.push('■ 回答上、整っていること');
   949	    if (result.goodItems.length === 0) {
   950	      lines.push('・確認済みの項目はまだありません');
   951	    } else {
   952	      for (var g = 0; g < result.goodItems.length; g++) {
   953	        lines.push('・' + result.goodItems[g].text);
   954	      }
   955	    }
   956	    lines.push('');
   957	
   958	    lines.push('■ まず見直すこと');
   959	    if (result.noWebsiteAdvice) {
   960	      lines.push('※' + result.noWebsiteAdvice);
   961	    }
   962	    if (result.reviewItems.length === 0) {
   963	      lines.push(
   964	        result.statusType === 'unknown_only'
   965	          ? '・まず現状を確認しましょう（明確な不備は選択されていません）'
   966	          : '・今回の回答では、優先して直す項目は見つかりませんでした'
   967	      );
   968	    } else {
   969	      for (var r = 0; r < result.reviewItems.length; r++) {
   970	        var item = result.reviewItems[r];
   971	        lines.push((r + 1) + '. ' + item.title);
   972	        lines.push('   あなたの回答：「' + item.answerLabel + '」');
   973	        lines.push('   ' + item.body);
   974	      }
   975	    }
   976	    lines.push('');
   977	
   978	    lines.push('■ まだ確認していないこと');
   979	    if (result.unknownItems.length === 0) {
   980	      lines.push('・なし');
   981	    } else {
   982	      for (var u = 0; u < result.unknownItems.length; u++) {
   983	        var uItem = result.unknownItems[u];
   984	        lines.push('・' + uItem.title + '（あなたの回答：「' + uItem.answerLabel + '」）');
   985	        lines.push('  ' + uItem.procedure);
   986	      }
   987	    }
   988	    lines.push('');
   989	
   990	    lines.push('■ あなたの回答一覧');
   991	    for (var s = 0; s < result.answeredSummary.length; s++) {
   992	      var ans = result.answeredSummary[s];
   993	      lines.push('質問' + ans.displayNumber + '：' + ans.questionText + ' → ' + (ans.answerLabel || '未回答'));
   994	    }
   995	
   996	    return lines.join('\n');
   997	  }
   998	
   999	  // Event Listeners
  1000	  if (btnStart) {
  1001	    btnStart.addEventListener('click', function () {
  1002	      showStep('question', 'Q1');
  1003	    });
  1004	  }
  1005	
  1006	  // Option selection listeners on question panels
  1007	  var optionInputs = stepQuestion.querySelectorAll('input.shindan-radio');
  1008	  for (var idx = 0; idx < optionInputs.length; idx++) {
  1009	    optionInputs[idx].addEventListener('change', function (e) {
  1010	      var target = e.target;
  1011	      var qId = target.getAttribute('data-q') || target.name;
  1012	      var val = target.getAttribute('data-value') || target.value;
  1013	      setAnswer(qId, val);
  1014	    });
  1015	  }
  1016	
  1017	  var optionLabels = stepQuestion.querySelectorAll('label.shindan-option');
  1018	  for (var lIdx = 0; lIdx < optionLabels.length; lIdx++) {
  1019	    optionLabels[lIdx].addEventListener('click', function (e) {
  1020	      var label = e.currentTarget;
  1021	      var qId = label.getAttribute('data-q');
  1022	      var val = label.getAttribute('data-value');
  1023	      if (qId && val) {
  1024	        setAnswer(qId, val);
  1025	      }
  1026	    });
  1027	  }
  1028	
  1029	  if (btnNext) {
  1030	    btnNext.addEventListener('click', function () {
  1031	      var currentQId = state.currentQuestionId;
  1032	      // Check DOM radio in case it was set directly without firing change
  1033	      var checkedRadio = stepQuestion.querySelector('input[name="' + currentQId + '"]:checked');
  1034	      if (checkedRadio && !state.answers[currentQId]) {
  1035	        setAnswer(currentQId, checkedRadio.value);
  1036	      }
  1037	
  1038	      if (!state.answers[currentQId]) {
  1039	        showQuestionError();
  1040	        return;
  1041	      }
  1042	
  1043	      var activeIds = getActiveQuestionIds(state.answers);
  1044	      var currentIdx = activeIds.indexOf(currentQId);
  1045	      if (currentIdx === -1) {
  1046	        currentIdx = 0;
  1047	      }
  1048	
  1049	      if (currentIdx < activeIds.length - 1) {
  1050	        showStep('question', activeIds[currentIdx + 1]);
  1051	      } else {
  1052	        showStep('result');
  1053	      }
  1054	    });
  1055	  }
  1056	
  1057	  if (btnPrev) {
  1058	    btnPrev.addEventListener('click', function () {
  1059	      var activeIds = getActiveQuestionIds(state.answers);
  1060	      var currentIdx = activeIds.indexOf(state.currentQuestionId);
  1061	      if (currentIdx > 0) {
  1062	        showStep('question', activeIds[currentIdx - 1]);
  1063	      } else {
  1064	        showStep('intro');
  1065	      }
  1066	    });
  1067	  }
  1068	
  1069	  if (btnReviewAnswers) {
  1070	    btnReviewAnswers.addEventListener('click', function () {
  1071	      showStep('review');
  1072	    });
  1073	  }
  1074	
  1075	  if (btnRecalculate) {
  1076	    btnRecalculate.addEventListener('click', function () {
  1077	      // Ensure all active questions have an answer; if Q2 became active without answer, go to Q2
  1078	      var activeIds = getActiveQuestionIds(state.answers);
  1079	      for (var i = 0; i < activeIds.length; i++) {
  1080	        if (!state.answers[activeIds[i]]) {
  1081	          showStep('question', activeIds[i]);
  1082	          return;
  1083	        }
  1084	      }
  1085	      showStep('result');
  1086	    });
  1087	  }
  1088	
  1089	  if (btnCancelReview) {
  1090	    btnCancelReview.addEventListener('click', function () {
  1091	      showStep('result');
  1092	    });
  1093	  }
  1094	
  1095	  if (btnRestart) {
  1096	    btnRestart.addEventListener('click', function () {
  1097	      state.answers = {};
  1098	      state.currentQuestionId = 'Q1';
  1099	      clearStorage();
  1100	      syncRadiosFromAnswers();
  1101	      showStep('intro');
  1102	    });
  1103	  }
  1104	
  1105	  if (btnCopyResult) {
  1106	    btnCopyResult.addEventListener('click', function () {
  1107	      var text = buildCopyText();
  1108	      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
  1109	        navigator.clipboard.writeText(text).then(
  1110	          function () {
  1111	            if (copyStatus) {
  1112	              copyStatus.textContent = '診断結果をクリップボードにコピーしました。相談時のメモとして貼り付けてご利用いただけます。';
  1113	              copyStatus.hidden = false;
  1114	            }
  1115	            if (copyFallbackBox) {
  1116	              copyFallbackBox.hidden = true;
  1117	            }
  1118	          },
  1119	          function () {
  1120	            showCopyFallback(text);
  1121	          }
  1122	        );
  1123	      } else {
  1124	        showCopyFallback(text);
  1125	      }
  1126	    });
  1127	  }
  1128	
  1129	  function showCopyFallback(text) {
  1130	    if (copyStatus) {
  1131	      copyStatus.textContent = '自動コピーできなかったため、下のテキスト欄から選択してコピーしてください。';
  1132	      copyStatus.hidden = false;
  1133	    }
  1134	    if (copyFallbackBox && copyFallbackTextarea) {
  1135	      copyFallbackTextarea.value = text;
  1136	      copyFallbackBox.hidden = false;
  1137	      copyFallbackTextarea.focus();
  1138	      copyFallbackTextarea.select();
  1139	    }
  1140	  }
  1141	
  1142	  if (btnPrint) {
  1143	    btnPrint.addEventListener('click', function () {
  1144	      if (typeof window.print === 'function') {
  1145	        window.print();
  1146	      }
  1147	    });
  1148	  }
  1149	
  1150	  // Browser back/forward restoration via History API
  1151	  window.addEventListener('popstate', function (e) {
  1152	    var hist = e.state;
  1153	    if (hist && hist.shindan) {
  1154	      showStep(hist.step || 'intro', hist.currentQuestionId || 'Q1', {
  1155	        fromPopState: true
  1156	      });
  1157	    } else {
  1158	      showStep('intro', 'Q1', { fromPopState: true });
  1159	    }
  1160	  });
  1161	
  1162	  // Initialize from sessionStorage if available, otherwise start at intro
  1163	  var saved = loadStateFromStorage();
  1164	  if (saved) {
  1165	    state.answers = saved.answers;
  1166	    state.currentQuestionId = saved.currentQuestionId;
  1167	    state.step = saved.step;
  1168	    showStep(state.step, state.currentQuestionId, {
  1169	      replaceHistory: true,
  1170	      skipFocus: true
  1171	    });
  1172	  } else {
  1173	    showStep('intro', 'Q1', {
  1174	      replaceHistory: true,
  1175	      skipFocus: true
  1176	    });
  1177	  }
  1178	})();
