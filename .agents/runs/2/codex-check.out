   965	          ? '・まず現状を確認しましょう（明確な不備は選択されていません）'
   966	          : '・今回の回答では、優先して直す項目は見つかりませんでした'
   967	      );
   968	    } else {
   969	      for (var r = 0; r < result.reviewItems.length; r++) {
