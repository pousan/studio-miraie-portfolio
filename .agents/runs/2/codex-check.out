   271	      if (val && GOOD_RULES[qId] && GOOD_RULES[qId][val]) {
   272	        goodItems.push({
   273	          questionId: qId,
   274	          value: val,
   275	          text: GOOD_RULES[qId][val]
   276	        });
   277	      }
   278	    }
   279	
   280	    // 2. Review items ("まず見直すこと", sorted by PRIORITY_ORDER: Q3・Q4 -> Q2・Q6 -> Q5・Q7)
   281	    var reviewItems = [];
   282	    for (var p = 0; p < PRIORITY_ORDER.length; p++) {
   283	      var prioQId = PRIORITY_ORDER[p];
   284	      if (prioQId === 'Q2' && answers.Q1 !== 'site') {
   285	        continue;
   286	      }
   287	      var ansVal = answers[prioQId];
   288	      if (ansVal && REVIEW_RULES[prioQId] && REVIEW_RULES[prioQId][ansVal]) {
   289	        var rule = REVIEW_RULES[prioQId][ansVal];
   290	        reviewItems.push({
   291	          questionId: prioQId,
   292	          value: ansVal,
   293	          title: rule.title,
   294	          answerLabel: rule.answerLabel,
   295	          body: rule.body
   296	        });
   297	      }
   298	    }
   299	
   300	    var primaryReviewItems = reviewItems.slice(0, 3);
   301	    var remainingReviewItems = reviewItems.slice(3);
   302	
   303	    // 3. Unknown items ("まだ確認していないこと")
   304	    var unknownItems = [];
   305	    for (var u = 0; u < activeQuestionIds.length; u++) {
   306	      var uQId = activeQuestionIds[u];
   307	      var uVal = answers[uQId];
   308	      if (uVal === 'unknown' && UNKNOWN_RULES[uQId]) {
   309	        unknownItems.push({
   310	          questionId: uQId,
   311	          value: uVal,
   312	          title: UNKNOWN_RULES[uQId].title,
   313	          answerLabel: UNKNOWN_RULES[uQId].answerLabel,
   314	          procedure: UNKNOWN_RULES[uQId].procedure
   315	        });
   316	      }
   317	    }
   318	
   319	    // Website-less guidance when Q1 is social or none
   320	    var noWebsiteAdvice = '';
   321	    if (answers.Q1 === 'social') {
   322	      noWebsiteAdvice = 'ホームページをお持ちでない場合も、まずは現在お使いのInstagramや店舗紹介ページ、Googleマップに「営業時間・定休日・場所・主なメニュー・連絡方法」の基本案内を揃えることから始められます。ホームページ制作だけが唯一の解決策ではありません。複数の媒体の情報をひとつにまとめたくなった段階で制作をご検討ください。';
   323	    } else if (answers.Q1 === 'none') {
   324	      noWebsiteAdvice = 'ホームページやSNSをお持ちでない場合も、まずは無料で登録できるGoogleマップ（Googleビジネスプロフィール）やInstagramなどに「営業時間・定休日・住所・主なメニュー」の基本案内を揃えることから始められます。ホームページ制作だけが唯一の解決策ではありません。';
   325	    }
   326	
   327	    // Status message logic (all good vs unknown only vs has review items)
   328	    var statusType = 'has_issues';
   329	    var statusMessage = '';
   330	    if (reviewItems.length === 0 && unknownItems.length === 0) {
   331	      statusType = 'all_good';
   332	      statusMessage = '今回の回答では、優先して直す項目は見つかりませんでした。';
   333	    } else if (reviewItems.length === 0 && unknownItems.length > 0) {
   334	      statusType = 'unknown_only';
   335	      statusMessage = 'まず現状を確認しましょう。今回の回答では明確な不備は選ばれていませんが、まだ確認していない項目があります。下の確認手順に沿って現在の案内状況を確かめてみてください。';
   336	    }
   337	
   338	    // Answered items summary with renumbered display numbers
   339	    var answeredSummary = [];
   340	    for (var s = 0; s < activeQuestionIds.length; s++) {
   341	      var sQId = activeQuestionIds[s];
   342	      var sQ = QUESTION_MAP[sQId];
   343	      var sVal = answers[sQId] || '';
   344	      answeredSummary.push({
   345	        questionId: sQId,
   346	        displayNumber: s + 1,
   347	        questionText: sQ ? sQ.text : '',
   348	        value: sVal,
   349	        answerLabel: getOptionLabel(sQId, sVal)
   350	      });
   351	    }
   352	
   353	    return {
   354	      activeQuestionIds: activeQuestionIds,
   355	      totalQuestions: activeQuestionIds.length,
   356	      answers: answers,
   357	      goodItems: goodItems,
   358	      reviewItems: reviewItems,
   359	      primaryReviewItems: primaryReviewItems,
   360	      remainingReviewItems: remainingReviewItems,
   361	      unknownItems: unknownItems,
   362	      noWebsiteAdvice: noWebsiteAdvice,
   363	      statusType: statusType,
   364	      statusMessage: statusMessage,
   365	      answeredSummary: answeredSummary
   366	    };
   367	  }
