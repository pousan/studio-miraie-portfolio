const ctx={window:{},document:{getElementById:()=>null}};vm.createContext(ctx);
vm.runInContext(fs.readFileSync('site/js/shindan.js','utf8').replace('window.evaluate = evaluate;', 'window.questions = QUESTIONS; window.evaluate = evaluate;'),ctx);
const spec=fs.readFileSync('.agents/runs/2/research.md','utf8'),html=fs.readFileSync('site/shindan.html','utf8');
for(const q of ctx.window.questions){const row=spec.split('\\n').find(l=>l.startsWith('| '+q.id+' |'));assert(row.includes(q.text)); const panel=html.split('id=\"panel-'+q.id+'\"')[1].split('</fieldset>')[0];assert(panel.includes(q.text));for(const o of q.options){assert(row.includes(o.label+'（'+o.value+'）'));assert(panel.includes('value=\"'+o.value+'\"'));assert(panel.includes('>'+o.label+'</span>'));}}
