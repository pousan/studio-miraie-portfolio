  1103	  }
  1104	
  1105	  if (btnCopyResult) {
  1106	    btnCopyResult.addEventListener('click', function () {
  1107	      var text = buildCopyText();
  1108	      if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
  1109	        navigator.clipboard.writeText(text).then(
  1110	          function () {
  1111	            if (copyStatus) {
  1112	              copyStatus.textContent = '診断結果をクリップボードにコピーしました。相談時のメモとして貼り付けてご利用いただけます。';
  1113	              copyStatus.hidden = false;
  1114	            }
  1115	            if (copyFallbackBox) {
  1116	              copyFallbackBox.hidden = true;
  1117	            }
  1118	          },
  1119	          function () {
  1120	            showCopyFallback(text);
  1121	          }
  1122	        );
  1123	      } else {
  1124	        showCopyFallback(text);
  1125	      }
  1126	    });
  1127	  }
  1128	
  1129	  function showCopyFallback(text) {
  1130	    if (copyStatus) {
  1131	      copyStatus.textContent = '自動コピーできなかったため、下のテキスト欄から選択してコピーしてください。';
  1132	      copyStatus.hidden = false;
  1133	    }
  1134	    if (copyFallbackBox && copyFallbackTextarea) {
  1135	      copyFallbackTextarea.value = text;
  1136	      copyFallbackBox.hidden = false;
  1137	      copyFallbackTextarea.focus();
  1138	      copyFallbackTextarea.select();
  1139	    }
  1140	  }
  1141	
  1142	  if (btnPrint) {
  1143	    btnPrint.addEventListener('click', function () {
  1144	      if (typeof window.print === 'function') {
  1145	        window.print();
  1146	      }
  1147	    });
  1148	  }
  1149	
  1150	  // Browser back/forward restoration via History API
  1151	  window.addEventListener('popstate', function (e) {
  1152	    var hist = e.state;
  1153	    if (hist && hist.shindan) {
  1154	      showStep(hist.step || 'intro', hist.currentQuestionId || 'Q1', {
  1155	        fromPopState: true
  1156	      });
  1157	    } else {
  1158	      showStep('intro', 'Q1', { fromPopState: true });
  1159	    }
  1160	  });
  1161	
  1162	  // Initialize from sessionStorage if available, otherwise start at intro
  1163	  var saved = loadStateFromStorage();
  1164	  if (saved) {
  1165	    state.answers = saved.answers;
  1166	    state.currentQuestionId = saved.currentQuestionId;
  1167	    state.step = saved.step;
  1168	    showStep(state.step, state.currentQuestionId, {
  1169	      replaceHistory: true,
  1170	      skipFocus: true
  1171	    });
  1172	  } else {
  1173	    showStep('intro', 'Q1', {
  1174	      replaceHistory: true,
  1175	      skipFocus: true
  1176	    });
  1177	  }
  1178	})();
  1180	}
