  1404	  gap: 16px;
  1405	  margin-top: 20px;
  1406	}
  1407	
  1408	.shindan-result-card {
  1409	  background-color: var(--surface);
  1410	  border: 1px solid var(--border);
  1411	  border-left: 4px solid var(--accent);
  1412	  padding: 20px;
  1413	  border-radius: 2px;
  1414	}
  1415	
  1416	@media (min-width: 375px) {
  1417	  .shindan-result-card {
  1418	    padding: 24px;
  1419	  }
  1420	}
  1421	
  1422	.shindan-result-card h4 {
  1423	  font-family: var(--font-serif);
  1424	  font-size: 1.125rem;
  1425	  font-weight: 600;
  1426	  line-height: 1.45;
  1427	  color: var(--text);
  1428	  margin: 0 0 8px;
  1429	}
  1430	
  1431	.shindan-your-answer {
  1432	  display: inline-block;
  1433	  font-size: 0.875rem;
  1434	  font-weight: 600;
  1435	  line-height: 1.6;
  1436	  color: var(--muted);
  1437	  background-color: var(--bg);
  1438	  border: 1px solid var(--border);
  1439	  padding: 4px 10px;
  1440	  margin-bottom: 12px;
  1441	  border-radius: 2px;
  1442	}
  1443	
  1444	.shindan-good-list {
  1445	  list-style: none;
  1446	  margin: 16px 0 0;
  1447	  padding: 0;
  1448	  border-top: 1px solid var(--border);
  1449	}
  1450	
  1451	.shindan-good-list li {
  1452	  padding-block: 14px;
  1453	  border-bottom: 1px solid var(--border);
  1454	  display: flex;
  1455	  align-items: baseline;
  1456	  gap: 10px;
  1457	  max-width: 42em;
  1458	}
  1459	
  1460	.shindan-good-mark {
  1461	  font-size: 0.75rem;
  1462	  font-weight: 700;
  1463	  color: var(--accent);
  1464	  border: 1px solid var(--accent);
  1465	  background-color: var(--surface);
  1466	  padding: 2px 6px;
  1467	  flex-shrink: 0;
  1468	}
  1469	
  1470	.shindan-remaining-block {
  1471	  margin-top: 24px;
  1472	  padding: 20px;
  1473	  background-color: var(--surface);
  1474	  border: 1px solid var(--border);
  1475	}
  1476	
  1477	.shindan-answers-summary {
  1478	  margin-top: 20px;
  1479	  border-top: 1px solid var(--border);
  1480	}
  1481	
  1482	.shindan-answer-row {
  1483	  padding-block: 16px;
  1484	  border-bottom: 1px solid var(--border);
  1485	  display: flex;
  1486	  flex-direction: column;
  1487	  gap: 8px;
  1488	}
  1489	
  1490	@media (min-width: 768px) {
  1491	  .shindan-answer-row {
  1492	    flex-direction: row;
  1493	    align-items: baseline;
