const e=ctx.window.evaluate;
let r=e({Q1:'site',Q2:'issue',Q3:'issue',Q4:'issue',Q5:'issue',Q6:'issue',Q7:'issue'});assert.equal(r.reviewItems.map(x=>x.questionId).join(','),'Q3,Q4,Q2,Q6,Q5,Q7');assert.equal(r.primaryReviewItems.length,3);assert.equal(r.remainingReviewItems.length,3);
r=e({Q1:'unknown',Q2:'issue',Q3:'unknown',Q4:'unknown',Q5:'unknown',Q6:'unknown',Q7:'unknown'});assert.equal(r.reviewItems.length,0);assert.equal(r.unknownItems.length,6);assert.equal(r.statusType,'unknown_only');assert("'!('"'Q2' in r.answers));
r=e({Q1:'site',Q2:'yes',Q3:'delegate',Q4:'yes',Q5:'unused',Q6:'notneeded',Q7:'yes'});assert.equal(r.statusType,'all_good');assert(r.goodItems.some(x=>x.value==='delegate'));
console.log('全不備・全unknown・delegate/unused/notneeded: 合格');
console.log('未回答evaluate({}): '+JSON.stringify({status:e({}).statusType,message:e({}).statusMessage,unanswered:e({}).answeredSummary.filter(x=>"'!x.value).length}));
