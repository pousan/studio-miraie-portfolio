   842	  function renderReviewScreen() {
   843	    var container = document.getElementById('review-questions-container');
   844	    if (!container) return;
   845	    while (container.firstChild) {
   846	      container.removeChild(container.firstChild);
   847	    }
   848	
   849	    var activeIds = getActiveQuestionIds(state.answers);
   850	    for (var i = 0; i < activeIds.length; i++) {
   851	      var qId = activeIds[i];
   852	      var q = QUESTION_MAP[qId];
   853	      if (!q) continue;
   854	
   855	      var itemDiv = document.createElement('div');
   856	      itemDiv.className = 'shindan-review-item';
   857	
   858	      var fieldset = document.createElement('fieldset');
   859	      fieldset.className = 'shindan-fieldset';
   860	
   861	      var legend = document.createElement('legend');
   862	      legend.className = 'shindan-legend';
   863	
   864	      var numSpan = document.createElement('span');
   865	      numSpan.className = 'shindan-q-num';
   866	      numSpan.textContent = '質問' + (i + 1);
   867	      legend.appendChild(numSpan);
   868	      legend.appendChild(document.createTextNode(q.text));
   869	      fieldset.appendChild(legend);
   870	
   871	      if (q.supplement) {
   872	        var supp = document.createElement('p');
   873	        supp.className = 'shindan-supplement';
   874	        supp.textContent = q.supplement;
   875	        fieldset.appendChild(supp);
   876	      }
   877	
   878	      var optionsWrap = document.createElement('div');
   879	      optionsWrap.className = 'shindan-options';
   880	
   881	      for (var j = 0; j < q.options.length; j++) {
   882	        var opt = q.options[j];
   883	        var isChecked = state.answers[qId] === opt.value;
   884	
   885	        var label = document.createElement('label');
   886	        label.className = 'shindan-option' + (isChecked ? ' is-selected' : '');
   887	        label.setAttribute('data-review-q', qId);
   888	        label.setAttribute('data-review-value', opt.value);
   889	
   890	        var mainSpan = document.createElement('span');
   891	        mainSpan.className = 'shindan-option-main';
   892	
   893	        var radio = document.createElement('input');
   894	        radio.type = 'radio';
   895	        radio.className = 'shindan-radio';
   896	        radio.name = 'review-' + qId;
   897	        radio.value = opt.value;
   898	        radio.checked = isChecked;
   899	
   900	        radio.addEventListener(
   901	          'change',
   902	          (function (questionId, optionValue) {
   903	            return function () {
   904	              setAnswer(questionId, optionValue);
   905	              // If Q1 changed, Q2 visibility and question numbers change; if Q2 was newly revealed, set default or let user choose
   906	              if (questionId === 'Q1' && optionValue === 'site' && !state.answers.Q2) {
   907	                state.answers.Q2 = 'unknown';
   908	              }
   909	              renderReviewScreen();
   910	            };
   911	          })(qId, opt.value)
   912	        );
   913	
   914	        var textSpan = document.createElement('span');
   915	        textSpan.className = 'shindan-option-text';
   916	        textSpan.textContent = opt.label;
   917	
   918	        var badgeSpan = document.createElement('span');
   919	        badgeSpan.className = 'shindan-option-badge';
   920	        badgeSpan.setAttribute('aria-hidden', 'true');
   921	        badgeSpan.textContent = '選択中';
   922	
   923	        mainSpan.appendChild(radio);
   924	        mainSpan.appendChild(textSpan);
   925	        label.appendChild(mainSpan);
   926	        label.appendChild(badgeSpan);
   927	        optionsWrap.appendChild(label);
   928	      }
   929	
   930	      fieldset.appendChild(optionsWrap);
   931	      itemDiv.appendChild(fieldset);
   932	      container.appendChild(itemDiv);
   933	    }
   934	  }
