   620	    } else if (state.step === 'review') {
   621	      renderReviewScreen();
   622	      if (!opts.skipFocus) {
   623	        focusElement(document.getElementById('review-heading'));
   624	      }
   625	    } else if (state.step === 'result') {
   626	      renderResultScreen();
   627	      if (!opts.skipFocus) {
   628	        focusElement(document.getElementById('result-heading'));
   629	      }
   630	    }
   631	
   632	    saveStateToStorage();
   633	    if (!opts.fromPopState) {
   634	      pushHistoryState(Boolean(opts.replaceHistory));
   635	    }
   636	  }
