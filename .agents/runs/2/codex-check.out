   369	  // Expose pure function for testing/verification
   370	  window.evaluate = evaluate;
   371	  window.evaluateShindan = evaluate;
   372	
   373	  // State management
   374	  var state = {
   375	    version: STATE_VERSION,
   376	    step: 'intro',
   377	    currentQuestionId: 'Q1',
   378	    answers: {}
   379	  };
   380	
   381	  function saveStateToStorage() {
   382	    try {
   383	      var payload = JSON.stringify({
   384	        version: state.version,
   385	        step: state.step,
   386	        currentQuestionId: state.currentQuestionId,
   387	        answers: state.answers
   388	      });
   389	      window.sessionStorage.setItem(STORAGE_KEY, payload);
   390	    } catch (e) {
   391	      // Continue silently if sessionStorage is unavailable
   392	    }
   393	  }
   394	
   395	  function clearStorage() {
   396	    try {
   397	      window.sessionStorage.removeItem(STORAGE_KEY);
   398	    } catch (e) {
   399	      // Ignore
   400	    }
   401	  }
   402	
   403	  function loadStateFromStorage() {
   404	    try {
   405	      var raw = window.sessionStorage.getItem(STORAGE_KEY);
   406	      if (!raw) return null;
   407	      var parsed = JSON.parse(raw);
   408	      if (!parsed || parsed.version !== STATE_VERSION || typeof parsed.answers !== 'object') {
   409	        return null;
   410	      }
   411	      var cleanAnswers = {};
   412	      for (var i = 0; i < QUESTIONS.length; i++) {
   413	        var q = QUESTIONS[i];
   414	        var val = parsed.answers[q.id];
   415	        if (val && getOptionLabel(q.id, val)) {
   416	          cleanAnswers[q.id] = val;
   417	        }
   418	      }
   419	      if (cleanAnswers.Q1 !== 'site') {
   420	        delete cleanAnswers.Q2;
   421	      }
   422	      return {
   423	        version: STATE_VERSION,
   424	        step: parsed.step || 'intro',
   425	        currentQuestionId: parsed.currentQuestionId || 'Q1',
   426	        answers: cleanAnswers
   427	      };
   428	    } catch (e) {
   429	      return null;
   430	    }
   431	  }
