  1501	  min-width: 0;
  1502	}
  1503	
  1504	.shindan-answer-q {
  1505	  font-weight: 600;
  1506	  color: var(--text);
  1507	  margin-bottom: 4px;
  1508	}
  1509	
  1510	.shindan-answer-val {
  1511	  font-size: 0.875rem;
  1512	  color: var(--muted);
  1513	  margin: 0;
  1514	}
  1515	
  1516	.shindan-copy-box {
